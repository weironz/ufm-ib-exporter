# syntax=docker/dockerfile:1
# Package exactly the static binaries that are uploaded to the GitHub Release.
# Context: config.example.yaml + binaries/{amd64,arm64}/ufm-ib-exporter.
FROM --platform=$BUILDPLATFORM rust:1.88-slim-bookworm@sha256:38bc5a86d998772d4aec2348656ed21438d20fcdce2795b56ca434cf21430d89 AS certificates
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
ARG TARGETARCH
COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chmod=0755 binaries/${TARGETARCH}/ufm-ib-exporter /usr/local/bin/ufm-ib-exporter
COPY --chmod=0644 config.example.yaml /etc/ufm-ib-exporter/config.example.yaml
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV UFM_CONFIG=/etc/ufm-ib-exporter/config.example.yaml
USER 65532:65532
EXPOSE 9627
ENTRYPOINT ["/usr/local/bin/ufm-ib-exporter"]
