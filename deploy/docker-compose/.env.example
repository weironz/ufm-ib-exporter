# cp .env.example .env; edit privately. Never commit .env.
# Required when REST is enabled. Keep the password out of public YAML.
UFM_PASSWORD=''

# Local-only by default. Set the UFM management IP for .34 to scrape.
LISTEN_ADDRESS=127.0.0.1
LISTEN_PORT=9627
UFM_CONFIG_DIR=./config
IMAGE=willdockerhub/ufm-ib-exporter:v0.1
RUST_LOG=info

# Native-binary overrides (environment overrides YAML).
# Compose passes only its explicit environment. For other fields, edit YAML or
# add the variable to a local Compose overlay.
# UFM_HOST=ufm.example.internal
# UFM_REST_URL=https://ufm.example.internal/ufmRest/resources/ports
# UFM_USERNAME=admin
# UFM_CA_FILE=/run/certificates/ufm-ca.pem
# UFM_COLLECT_REST=true
# UFM_REST_INTERVAL=60
# UFM_REST_TIMEOUT=30
# UFM_REST_MAX_AGE=180
# UFM_NODE_PREFIX=B300
# UFM_EXPECTED_NODES=32
# UFM_PORTS_PER_NODE=8
# UFM_COLLECT_9001=true
# UFM_9001_URL=http://127.0.0.1:9001/metrics
# UFM_9001_INTERVAL=180
# UFM_9001_KEEP=^(SymbolErrorCounter|LinkDownedCounter|PortRcvErrors)
# UFM_9001_NODE_FILTER=(?i)b300|q3400
# UFM_9001_MAX_BYTES=536870912
# UFM_9001_MAX_CACHE_BYTES=67108864
# UFM_9001_MAX_POLL_SECONDS=120
# UFM_9001_MAX_OBSERVATION_AGE=420
# UFM_9001_REQUIRE_TIMESTAMPS=true
# UFM_COLLECT_9002=true
# UFM_9002_URL=http://127.0.0.1:9002/metrics/CableInfo
# UFM_9002_INTERVAL=600
# UFM_9002_KEEP=^(rx_power_lane[0-7]|tx_power_lane[0-7]|cable_temperature)$
