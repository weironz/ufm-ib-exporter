# 复制本文件为 .env 并填入真实凭据。.env 已在 .gitignore,不会提交。
#   cp .env.example .env

# UFM(InfiniBand SM)REST 凭据
UFM_HOST=172.16.30.33
UFM_USERNAME=admin
UFM_PASSWORD=请填写UFM_REST密码

# 可选:基线(整节点消失检测;缺席节点会被强制补 0)
# UFM_NODE_PREFIX=B300
# UFM_EXPECTED_NODES=32
# UFM_PORTS_PER_NODE=8

# 可选:覆盖本地镜像名
# IMAGE=ufm-ib-exporter:latest
