# 复制本文件为 .env 并填入真实凭据。.env 已在 .gitignore,不会提交。
#   cp .env.example .env

# UFM(InfiniBand SM)REST 凭据
UFM_HOST=172.16.30.33
UFM_USERNAME=admin
UFM_PASSWORD=请填写UFM_REST密码

# 可选:基线(整节点消失检测;缺席节点会被强制补 0)
# UFM_NODE_PREFIX=B300
# UFM_EXPECTED_NODES=32
# UFM_PORTS_PER_NODE=8

# ============ 三源开关(REST + :9001 + :9002,各自独立启停)============
# 源1 · REST(/resources/ports → 链路 up/down)—— 默认开。走 https 到 UFM_HOST(mgmt IP)。
# UFM_COLLECT_REST=true

# 源2 · Telemetry :9001(counters → 误码/错误/FEC,链路劣化)—— 默认关。
#   地址可传参:放 UFM 主机上跑就用 loopback;放别处且 telemetry 已暴露 mgmt IP 就填 mgmt IP。
# UFM_COLLECT_9001=false
# UFM_9001_URL=http://127.0.0.1:9001/metrics        # loopback(UFM 默认绑这)或 http://172.16.30.33:9001/metrics
# UFM_9001_INTERVAL=180                              # 后台拉取间隔(秒),BER 是慢变量,不必密
# UFM_9001_NODE_FILTER=                              # node_description 正则,空=全收;如只要 B300|Q3400
# UFM_9001_KEEP=                                     # 指标名白名单正则,空=用代码默认(IB错误计数+PHY误码+FEC)

# 源3 · Telemetry :9002(rich → 光功率/温度/cable)—— 默认关,单次 1.26GB,慎用。
# UFM_COLLECT_9002=false
# UFM_9002_URL=http://127.0.0.1:9002/metrics
# UFM_9002_INTERVAL=300
# UFM_9002_NODE_FILTER=
# UFM_9002_KEEP=                                     # 自行扩白名单取光功率/温度,否则同 :9001 默认

# 可选:覆盖本地镜像名
# IMAGE=ufm-ib-exporter:latest
