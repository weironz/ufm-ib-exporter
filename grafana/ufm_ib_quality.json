    {
      "type": "timeseries",
      "title": "FEC 纠错计数变化率（非显式 BER）",
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(topk(10, rate(phy_c_rs_fec_corrected_symbols_total_high[12m]))) and on(job, instance) (ufm_telemetry_up{source=\"9001\"} == 1)",
          "legendFormat": "{{host_name}} {{m_label}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        }
      },
      "description": "以 12 分钟窗口计算计数器变化率，适配 180 秒抓取间隔；这不是 BER。"
    },
    {
